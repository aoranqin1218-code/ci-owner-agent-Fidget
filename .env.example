# Jenkins
JENKINS_URL=
JENKINS_USER=
JENKINS_TOKEN=

# Repository cache and agent limits
CI_AGENT_REPO_CACHE_DIR=repos
CI_AGENT_DEFAULT_LOG_TAIL_LINES=500
CI_AGENT_MAX_TOOL_STEPS=12
CI_AGENT_MAX_TOOL_OUTPUT_CHARS=20000
# config.py 未显式配置时使用 max(CI_AGENT_MAX_TOOL_STEPS * 4, 40)；按默认步骤数计算为 48。
CI_AGENT_RECURSION_LIMIT=48

# LLM
# 可选值：fake、openai、deepseek、doubao、openai-compatible
CI_AGENT_MODEL_PROVIDER=fake
CI_AGENT_MODEL_BASE_URL=
CI_AGENT_MODEL_NAME=
CI_AGENT_API_KEY=
CI_AGENT_MODEL_TIMEOUT_SECONDS=90
CI_AGENT_MODEL_MAX_RETRIES=1
# 可选值：tool、json_text
CI_AGENT_RESPONSE_FORMAT=tool

# TypeScript analyzer
TS_ANALYZER_DIR=./ts-analyzer

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ci-owner-agent-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# History and MongoDB
CI_AGENT_HISTORY_ENABLED=false
CI_AGENT_HISTORY_MONGO_URI=mongodb://localhost:27017
CI_AGENT_HISTORY_MONGO_DB=ci_owner_agent
CI_AGENT_WEEKLY_TEST_REPORT_CONFIG_FILE=config/weekly-test-report.yml
CI_AGENT_HISTORY_MAX_CANDIDATES=5
CI_AGENT_HISTORY_INHERIT_NO_OWNER_ENABLED=true
CI_AGENT_FAILURE_CHUNK_TAIL_LINES=500

# AI failure facts
CI_AGENT_AI_FAILURE_FACTS_ENABLED=false
CI_AGENT_AI_FAILURE_FACT_MIN_CONFIDENCE=0.70
CI_AGENT_AI_FAILURE_FACT_MAX_LOG_CHARS=12000

# AI history comparison
CI_AGENT_AI_HISTORY_COMPARE_ENABLED=false
CI_AGENT_AI_HISTORY_COMPARE_THRESHOLD=0.90
CI_AGENT_AI_HISTORY_MAX_FACT_CANDIDATES=20
CI_AGENT_AI_HISTORY_MAX_COMPARE_CALLS=20

# Metrics
CI_AGENT_METRICS_ENABLED=false
CI_AGENT_METRICS_FILE=./runs/metrics/ci_analysis_metrics.jsonl

# 企业微信 CI 通知
CI_AGENT_WECOM_NOTIFY_ENABLED=false
CI_AGENT_WECOM_NOTIFY_TRANSPORT=webhook
CI_AGENT_WECOM_WEBHOOK_URL=
CI_AGENT_WECOM_NOTIFY_DRY_RUN=true
CI_AGENT_WECOM_NOTIFY_ON_SUCCESS=false
CI_AGENT_WECOM_NOTIFY_ON_NO_OWNER=true
CI_AGENT_WECOM_MENTION_MODE=userid

# Notification routing and deduplication
CI_AGENT_WECOM_USER_MAPPING_FILE=
# 生产环境显式设置，例如 ./config/test-maintainers.yml；留空表示不启用路径维护人配置。
CI_AGENT_TEST_MAINTAINER_MAPPING_FILE=
# 多个企业微信 userid 使用英文逗号分隔。
CI_AGENT_WECOM_FALLBACK_USERIDS=
CI_AGENT_NOTIFICATION_DEDUP_ENABLED=true

# WeCom AI bot LLM natural language parsing (requires CI_AGENT_MODEL_PROVIDER != fake)
CI_AGENT_WECOM_BOT_LLM_ENABLED=false
CI_AGENT_WECOM_BOT_LLM_MAX_INPUT_CHARS=2000

# 智能机器人（长连接；始终可处理群内反馈）
CI_AGENT_WECOM_BOT_ENABLED=false
CI_AGENT_WECOM_BOT_ID=
CI_AGENT_WECOM_BOT_SECRET=
# 临时获取群 chatid 时显式开启；正常运行必须保持 false。开启后每个进程仅输出第一次群聊 chatid，获取完成后立即关闭。
CI_AGENT_WECOM_BOT_DISCOVER_CHAT_ID=false
# 仅 TRANSPORT=bot 时用于主动 CI 通知
CI_AGENT_WECOM_BOT_NOTIFY_CHAT_ID=
CI_AGENT_WECOM_BOT_NOTIFY_POLL_SECONDS=2
CI_AGENT_WECOM_BOT_NOTIFY_LEASE_SECONDS=30
CI_AGENT_WECOM_BOT_NOTIFY_MAX_ATTEMPTS=5
CI_AGENT_WECOM_BOT_CONFIRM_TTL_SECONDS=300
CI_AGENT_WECOM_FEEDBACK_CODE_TTL_DAYS=30
CI_AGENT_WECOM_BOT_EVENT_TTL_DAYS=7

# 飞书测试群 CI 单向通知（群自定义机器人 Webhook）
# 默认关闭且 dry-run 开启：仅显式配置并关闭 dry-run 后才允许真实发送。
# Webhook URL 与 Secret 属敏感配置，不得提交真实值；CLI `notify-notice --channel feishu` 用于手动发送。
CI_AGENT_FEISHU_NOTIFY_ENABLED=false
CI_AGENT_FEISHU_WEBHOOK_URL=
# 仅当机器人在「安全设置」开启了签名校验时才需要；未配置签名只能使用未开启签名校验的测试机器人。
CI_AGENT_FEISHU_WEBHOOK_SECRET=
CI_AGENT_FEISHU_NOTIFY_DRY_RUN=true
CI_AGENT_FEISHU_NOTIFY_ON_SUCCESS=false
CI_AGENT_FEISHU_NOTIFY_ON_NO_OWNER=true
# 飞书 open_id 映射文件（YAML: users: [{name, email?, openId}]）；仅用于真实 @ 群成员，无映射时保守降级为姓名文本。
CI_AGENT_FEISHU_USER_MAPPING_FILE=
# 多个飞书 open_id 使用英文逗号分隔；显式配置的兜底通知对象，不得猜测。
CI_AGENT_FEISHU_FALLBACK_USER_IDS=

# Feedback
CI_AGENT_FEEDBACK_BASE_URL=
CI_AGENT_FEEDBACK_SERVER_HOST=127.0.0.1
CI_AGENT_FEEDBACK_SERVER_PORT=8765
CI_AGENT_FEEDBACK_SHARED_TOKEN=
